MARKETPLACELENS_DB_PATH=/data/marketplacelens.db
MARKETPLACELENS_POLL_ENABLED=true
MARKETPLACELENS_MIN_POLL_MINUTES=30
MARKETPLACELENS_DEFAULT_POLL_MINUTES=60
MARKETPLACELENS_USER_AGENT=MarketPlaceLens/0.4.1 (+self-hosted listing watcher)
MARKETPLACELENS_ADMIN_USERNAME=admin
MARKETPLACELENS_BUILD_CODE=20260618.8
MARKETPLACELENS_BUILD_COMMIT=dev
MARKETPLACELENS_BUILD_BRANCH=main
MARKETPLACELENS_BUILD_CREATED=

# Optional. Can also be configured in the UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MARKETPLACELENS_WEBHOOK_URL=

# Set 0.0.0.0 only when LAN exposure is intended.
MARKETPLACELENS_BIND_ADDRESS=127.0.0.1
MARKETPLACELENS_PORT=8091
# Set true when served via an HTTPS reverse proxy.
MARKETPLACELENS_COOKIE_SECURE=false

# Optional eBay Browse API (production access required)
MARKETPLACELENS_EBAY_CLIENT_ID=
MARKETPLACELENS_EBAY_CLIENT_SECRET=

# Enable only with Amazon's approval for this comparison and alert-enabled application.
MARKETPLACELENS_AMAZON_APPROVED=false
MARKETPLACELENS_AMAZON_CLIENT_ID=
MARKETPLACELENS_AMAZON_CLIENT_SECRET=
MARKETPLACELENS_AMAZON_PARTNER_TAG=
MARKETPLACELENS_AMAZON_CREDENTIAL_VERSION=3.2
